# Guest-entry mounts the packaged ROM images before Android init runs.
# Only the two guest loop volumes below may be formatted by fs_mgr.
/dev/block/skyward/metadata /metadata ext4 rw,noatime,nosuid,nodev wait,check,formattable
/dev/block/skyward/userdata /data ext4 rw,noatime,nosuid,nodev wait,check,latemount,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption
/dev/block/skyward/persist /mnt/vendor/persist ext4 rw,noatime,nosuid,nodev wait

# OS3.0.309.0 firmware; noload prevents ext4 journal replay on a read-only mount.
/dev/block/bootdevice/by-name/modem /vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
/dev/block/bootdevice/by-name/dsp /vendor/dsp ext4 ro,nosuid,nodev,noload wait,slotselect
/dev/block/bootdevice/by-name/bluetooth /vendor/bt_firmware vfat ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait,slotselect
